# SELMA Labs Environment Configuration Example
# Copy this file to .env and set your service credentials.

# Anthropic Claude (Script Generation & Scene Planning)
ANTHROPIC_API_KEY=
CLAUDE_SCRIPT_MODEL=claude-sonnet-4-5
SCENE_PLANNING_MODEL=claude-sonnet-4-5

# ElevenLabs (Voice Generation)
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Pexels (Video Search)
VIDEO_PROVIDER=pexels
PEXELS_API_KEY=
DEFAULT_VIDEO_MAX_RESULTS=10

# Local Storage Root Directory
STORAGE_ROOT_DIR=output

# Voice Cache Settings
VOICE_CACHE_ENABLED=true
VOICE_CACHE_DIR=cache/voice

# Subtitle Translation Provider Switch
TRANSLATION_PROVIDER=claude

# Video Rendering (FFmpeg local binary settings)
RENDER_PROVIDER=ffmpeg
FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe
RENDER_OUTPUT_WIDTH=1080
RENDER_OUTPUT_HEIGHT=1920
RENDER_FPS=30
