# SELMA Labs Environment Configuration Example
# Copy this file to .env and set your service credentials.

# Text AI provider (NVIDIA by default; Claude remains optional)
SCRIPT_PROVIDER=nvidia
SCENE_PLANNING_PROVIDER=nvidia
TRANSLATION_PROVIDER=nvidia

# NVIDIA API Catalog (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_TIMEOUT_SECONDS=180

# Strict script fact-checking (no extra API key required)
FACT_SOURCE_PROVIDER=wikipedia
FACT_CHECK_PROVIDER=nvidia
NVIDIA_FACT_CHECK_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_FACT_CHECK_AUDIT_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
FACT_CHECK_SOURCE_LANGUAGE=en
FACT_CHECK_SOURCE_LIMIT=5
FACT_CHECK_MAX_EXTRACT_CHARS=5000
FACT_CHECK_REWRITE_ATTEMPTS=2
FACT_CHECK_PRIMARY_TIMEOUT_SECONDS=180

SCENE_MIN_VISUAL_BEATS=3
SUBTITLE_MAX_CHARS_PER_LINE=24
SUBTITLE_MAX_LINES_PER_CUE=1
SUBTITLE_MIN_CUE_SECONDS=0.8
BACKGROUND_MUSIC_PROVIDER=local
BACKGROUND_MUSIC_DIR=assets/music
BACKGROUND_MUSIC_ENABLED=true
BACKGROUND_MUSIC_VOLUME=0.16
PROCEDURAL_AUDIO_ACCENTS_ENABLED=true
AUDIO_MIX_PROVIDER=ffmpeg

# YouTube trend discovery (public data only; no OAuth required)
YOUTUBE_DATA_API_KEY=
TREND_SOURCE_PROVIDER=youtube
TOPIC_SELECTION_PROVIDER=nvidia
TREND_REGION_CODE=US
TREND_CATEGORY_IDS=15,27,28
TREND_MAX_RESULTS_PER_CATEGORY=20
TREND_CANDIDATE_LIMIT=20
TREND_MIN_DURATION_SECONDS=10
TREND_MAX_DURATION_SECONDS=180
TREND_SEARCH_QUERY=science facts|animal facts|nature facts
TREND_RELEVANCE_LANGUAGE=en
TREND_PUBLISHED_WITHIN_DAYS=30

# Optional Anthropic Claude fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REQUIRE_AUDIO_LICENSE_MANIFEST=true
AUDIO_LICENSE_MANIFEST_PATH=input_audio/license_manifest.json
SCRIPT_MODEL=claude-sonnet-4-5
SCENE_PLANNER_MODEL=claude-sonnet-4-5

# ElevenLabs (Voice Generation)
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.45
ELEVENLABS_SPEED=1.05
ELEVENLABS_USE_SPEAKER_BOOST=true
BRAND_SIGNATURE_ENABLED=true
BRAND_SIGNATURE_TEXT=Welcome to Strange Things.
PRONUNCIATION_LEXICON_PATH=assets/audio/pronunciation_lexicon.json

# Pexels (Video Search)
VIDEO_PROVIDER=pexels
PEXELS_API_KEY=
DEFAULT_VIDEO_MAX_RESULTS=10

# Autonomous keyframe generation (offline fake by default)
KEYFRAME_GENERATION_PROVIDER=fake
COMFYUI_API_URL=http://127.0.0.1:8188
COMFYUI_KEYFRAME_WORKFLOW_PATH=assets/comfyui_keyframe_workflow.json
COMFYUI_KEYFRAME_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_CHARACTER_LORA_NAME=
COMFYUI_CHARACTER_LORA_TRIGGER_TOKEN=
COMFYUI_CHARACTER_LORA_STRENGTH_MODEL=0.8
COMFYUI_CHARACTER_LORA_STRENGTH_CLIP=0.8
COMFYUI_KEYFRAME_TIMEOUT_SECONDS=300
COMFYUI_KEYFRAME_POLL_INTERVAL_SECONDS=1
IMAGE_TO_VIDEO_PROVIDER=fake
COMFYUI_I2V_WORKFLOW_PATH=assets/comfyui_i2v_workflow.json
COMFYUI_I2V_TIMEOUT_SECONDS=900
COMFYUI_I2V_POLL_INTERVAL_SECONDS=2

# Search Resilience & Cache
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_NEGATIVE_TTL_SECONDS=60
YOUTUBE_PERFORMANCE_STORE=data/youtube_performance.json
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF=0.5
PROVIDER_MAX_BACKOFF=30

# AI Vision Candidate Scoring
VISION_ENABLED=false
VISION_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-5.6-luna
VISION_MODEL=claude-haiku-4-5
VISION_FRAMES_PER_ASSET=3
VISION_TOP_CANDIDATES=5
VISION_MAX_CONCURRENCY=2
VISION_WEIGHT=0.65
ASSET_PERCEPTUAL_DISTANCE_THRESHOLD=7
ASSET_MAXIMUM_SOURCE_USES=2
ASSET_MAXIMUM_POSE_USES=2
ASSET_MAXIMUM_CAMERA_ANGLE_USES=2
ASSET_MAXIMUM_BACKGROUND_USES=3
EDITORIAL_ALIGNMENT_TOLERANCE_MS=120
EDITORIAL_MAXIMUM_LOW_MOTION_MS=2800
CAPTION_SAFE_MARGIN_LEFT=120
CAPTION_SAFE_MARGIN_RIGHT=120
CAPTION_BASELINE_Y=1420
CAPTION_FONT_SIZE=68
CAPTION_OUTLINE_WIDTH=6
CAPTION_ACTIVE_SCALE_PERCENT=106
CAPTION_MINIMUM_SCALED_EMPHASIS_MS=160

# Local Storage Root Directory
STORAGE_ROOT_DIR=output

# Voice Cache Settings
VOICE_CACHE_ENABLED=true
VOICE_CACHE_DIR=cache/voice

# Creative composition (Remotion) + final mastering (FFmpeg)
RENDER_PROVIDER=remotion
FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe
REMOTION_PROJECT_DIR=motion
# Leave blank to use motion/node_modules/.bin/remotion.cmd
REMOTION_CLI_PATH=
REMOTION_SUBPROCESS_TIMEOUT_SECONDS=900
RENDER_OUTPUT_WIDTH=1080
RENDER_OUTPUT_HEIGHT=1920
RENDER_FPS=30
