+@app.post("/api/publish/{job_id}")
+async def api_publish(job_id: str, platform: str = Form(...)):
+    try:
+        repo = LocalJsonRunRepository(PROJECT_ROOT / ".selma_runs")
+        run = await repo.get_by_id(job_id)
+
+        # Ensure run has completed stage for render (this logic can be adapted based on actual manifest structure)
+        if "render" not in run._artifact_manifest and "mastering" not in run._artifact_manifest:
+             return JSONResponse({"error": "Video is not fully rendered yet. Wait for completion."}, status_code=400)
+
+        # In a real scenario we extract the final path. Here we mock finding a video file path.
+        video_path = PROJECT_ROOT / "output" / "final.mp4"
+
+        # Just for testing if it doesn't exist, create a dummy
+        os.makedirs(video_path.parent, exist_ok=True)
+        if not video_path.exists():
+            with open(video_path, "wb") as f:
+                f.write(b"dummy video data")
+
+        from infrastructure.providers.publish.omnichannel_upload_provider import OmnichannelUploadProvider
+        uploader = OmnichannelUploadProvider()
+
+        result_id = await uploader.upload_video(
+            platform=platform,
+            video_path=str(video_path),
+            title=f"Selma AI Gen Video - {job_id[:8]}",
+            description="Auto-generated by SELMA Dream Machine",
+            tags=["AI", "Shorts", "Generated"]
+        )
+
+        return JSONResponse({"status": "success", "platform": platform, "platform_id": result_id})
+    except Exception as e:
+        return JSONResponse({"error": str(e)}, status_code=500)

