+    async def get_all(self) -> list[PipelineRun]:
+        """Retrieve all pipeline runs."""
+        runs = []
+        for file_path in self._base_path.glob("*.json"):
+            try:
+                run_id = file_path.stem
+                data = self._read_run(run_id)
+                runs.append(PipelineRun.model_validate(data))
+            except Exception:
+                continue
+        return runs
